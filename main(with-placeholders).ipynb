    "else:\n",
    "    X_viz = features_array\n",
    "    y_viz = df_features['category']\n",
    "\n",
    "print(f\"Visualization sample size: {len(X_viz)} images\")\n",
    "\n",
    "# 1. PCA - Principal Component Analysis\n",
